{
  "name": "@opal/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot dev.ts",
    "build": "rm -rf dist && NODE_ENV=production bun build ./index.html --outdir=dist --public-path=/ --minify --sourcemap=linked",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src dev.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "typescript": "^5.8.2"
  }
}
